---
import { getImage } from "astro:assets";
import Button from "./Button.astro";
import Text from "./Text.astro";

const { data } = Astro.props;

import slide1 from "../assets/slider/1.webp";
import slide2 from "../assets/slider/2.webp";
import slide3 from "../assets/slider/3.webp";
import slide4 from "../assets/slider/4.webp";
import slide5 from "../assets/slider/5.webp";
import slide6 from "../assets/slider/6.webp";
import slide7 from "../assets/slider/7.webp";
import slide8 from "../assets/slider/8.webp";
import slide9 from "../assets/slider/9.webp";
import edicoesIcon from "../assets/vectors/edicoes-consecutivas.svg";
import participantesIcon from "../assets/vectors/participantes-por-edicao.svg";

import SectionHeading from "./SectionHeading.astro";

const { intro, recognition } = data;

const recognitionIcons = [participantesIcon, edicoesIcon];

const slideAssets = [
  [slide1, slide2, slide3],
  [slide4, slide5, slide6],
  [slide7, slide8, slide9],
];

const slideGroups = await Promise.all(
  slideAssets.map((group) =>
    Promise.all(
      group.map((src) =>
        getImage({
          src,
          width: 620,
          format: "webp",
          quality: 100,
        }),
      ),
    ),
  ),
);

const sliderImages = slideGroups.flat();
---

<section class="bg-cream pt-12 lg:pt-20" data-intro-section>
  <div class="flex flex-col gap-6">
    <SectionHeading
      title={intro.title}
      description={intro.description}
      titleColor="blue"
      descriptionColor="ink"
    />

    <div class="container grid gap-4 md:grid-cols-2">
      {
        intro.items.map((item: any) => (
          <div class="flex min-h-31 flex-col justify-center rounded-3xl bg-blue px-8 py-7 text-left">
            <Text
              as="h4"
              color="white"
              class="mb-2 text-xl font-bold leading-tight"
            >
              {item.title}
            </Text>

            <Text as="p" color="white" class="text-sm leading-relaxed opacity-95">
              {item.description}
            </Text>
          </div>
        ))
      }
    </div>

    <div class="text-center">
      <Button>{intro.cta}</Button>
    </div>
  </div>

  <div class="recognition-section mt-6 bg-navy text-white">
    <div
      class="container flex flex-col items-center gap-12 text-center lg:gap-12.5"
    >
      <Text as="h2" variant="h2" color="white" class="max-w-87.5">
        {recognition.title}
      </Text>

      <div
        class="recognition-stats flex flex-col items-center justify-center gap-8 sm:flex-row sm:gap-16.25"
      >
        {
          recognition.items.map((item: any, index: number) => (
            <>
              {index > 0 && (
                <span
                  class="hidden h-12 w-px bg-white/20 sm:block"
                  aria-hidden="true"
                />
              )}

              <div class="flex items-center gap-4 text-left">
                  <img
                    src={recognitionIcons[index]?.src}
                    width="22"
                    height="22"
                    alt=""
                    class="size-14"
                    loading="lazy"
                  />
                <div class="flex flex-col gap-0">
                  <Text
                    as="strong"
                    color="white"
                    class="font-display text-[45px] font-bold leading-11.25 tracking-normal"
                  >
                    {item.value}
                  </Text>
                  <Text color="white" class="text-base leading-none opacity-60">
                    {item.label}
                  </Text>
                </div>
              </div>
            </>
          ))
        }
      </div>

      <Button>{recognition.cta}</Button>
    </div>
  </div>

  <div class="intro-slider-stage" data-intro-marquee>
    <div class="intro-slider-shell">
      <div class="intro-slider" aria-label="Fotos do evento" aria-live="off">
        {
          [0, 1].map((setIndex) => (
            <div class="intro-slider-track" aria-hidden={setIndex > 0}>
              {sliderImages.map((image, imageIndex) => (
                <figure class="intro-slide-frame">
                  <img
                    src={image.src}
                    width={image.attributes.width}
                    height={image.attributes.height}
                    alt=""
                    loading={setIndex === 0 && imageIndex < 3 ? "eager" : "lazy"}
                    decoding="async"
                  />
                </figure>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const marquees = document.querySelectorAll<HTMLElement>("[data-intro-marquee]");

  marquees.forEach((marquee) => {
    const setRunning = (isRunning: boolean) => {
      marquee.dataset.marqueeRunning = String(isRunning);
    };

    setRunning(false);

    if (!("IntersectionObserver" in window)) {
      setRunning(true);
      return;
    }

    const observer = new IntersectionObserver(
      ([entry]) => {
        setRunning(entry.isIntersecting);
      },
      {
        threshold: 0.2,
      },
    );

    observer.observe(marquee);
  });
</script>

<style>
  .recognition-section {
    padding-block: 48px;
  }

  @media (min-width: 1024px) {
    .recognition-section {
      padding-block: 80px 30px;
    }
  }

  .intro-slider-stage {
    background: var(--color-navy);
    overflow: hidden;
    padding-block: 0;
  }

  .intro-slider-shell {
    position: relative;
    overflow: hidden;
    height: clamp(360px, 31vw, 470px);
    background: var(--color-navy);
  }

  .intro-slider-shell::before,
  .intro-slider-shell::after {
    content: "";
    position: absolute;
    left: -8%;
    z-index: 3;
    width: 116%;
    height: clamp(70px, 8vw, 118px);
    pointer-events: none;
    background: var(--color-navy);
  }

  .intro-slider-shell::before {
    top: calc(clamp(70px, 8vw, 118px) * -0.62);
    border-radius: 0 0 50% 50%;
  }

  .intro-slider-shell::after {
    bottom: calc(clamp(70px, 8vw, 118px) * -0.62);
    border-radius: 50% 50% 0 0;
  }

  .intro-slider {
    position: relative;
    z-index: 1;
    display: flex;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .intro-slider-track {
    display: flex;
    flex: 0 0 max-content;
    gap: clamp(12px, 1.35vw, 20px);
    padding-right: clamp(12px, 1.35vw, 20px);
    animation: intro-marquee 38s linear infinite;
    animation-play-state: paused;
  }

  .intro-slider-stage[data-marquee-running="true"] .intro-slider-track {
    animation-play-state: running;
  }

  .intro-slide-frame {
    flex: 0 0 min(33vw, 620px);
    margin: 0;
    overflow: hidden;
  }

  .intro-slide-frame img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  @keyframes intro-marquee {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-slider-track {
      animation: none;
    }
  }

  @media (max-width: 767px) {
    .intro-slider-stage {
      padding-block: 0;
    }

    .intro-slider-shell {
      height: 64vw;
      min-height: 260px;
      max-height: 420px;
    }

    .intro-slider-shell::before,
    .intro-slider-shell::after {
      height: 70px;
    }

    .intro-slider-shell::before {
      top: -44px;
    }

    .intro-slider-shell::after {
      bottom: -44px;
    }

    .intro-slide-frame {
      flex-basis: 82vw;
    }

    .intro-slide-frame img {
      height: 100%;
      object-fit: cover;
    }
  }
</style>
