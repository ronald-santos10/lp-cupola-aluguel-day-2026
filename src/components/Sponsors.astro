---
import Text from "./Text.astro";
import data from "../data/data.json";

import credalugaLogo from "../assets/logos/credaluga.svg";
import fcanaliseLogo from "../assets/logos/fcanalise.svg";
import grazonLogo from "../assets/logos/grazon.svg";
import laisLogo from "../assets/logos/lais.svg";
import pipeimobLogo from "../assets/logos/pipeimob.svg";
import realmateLogo from "../assets/logos/realmate.svg";
import upstateLogo from "../assets/logos/upstate.svg";

import compagnoLogo from "../assets/logos/compagno.svg";
import flexproLogo from "../assets/logos/flexpro.svg";
import luguiLogo from "../assets/logos/lugui.svg";
import guiaAlmaLogo from "../assets/logos/guia-alma.svg";
import oragoLogo from "../assets/logos/orago.webp";

const { sponsors } = data;

const logos = {
  credaluga: credalugaLogo,
  realmate: realmateLogo,
  pipeimob: pipeimobLogo,
  grazon: grazonLogo,
  upstate: upstateLogo,
  fcanalise: fcanaliseLogo,
  lais: laisLogo,
  compagno: compagnoLogo,
  flexpro: flexproLogo,
  lugui: luguiLogo,
  "guia-alma": guiaAlmaLogo,
  orago: oragoLogo,
};
---

<section class="bg-cream py-12 lg:py-20">
  <div class="sponsors-container">
    <Text as="h2" color="ink" align="center" class="sponsors-title">
      {sponsors.title}
    </Text>

    <div class="sponsor-tier sponsor-tier--gold">
      <div class="sponsor-tier__heading">
        <span></span>
        <Text as="h3" color="ink" class="sponsor-tier__label">
          {sponsors.goldLabel}
        </Text>
        <span></span>
      </div>

      <div class="sponsor-logo-grid sponsor-logo-grid--gold-top">
        {
          sponsors.gold.slice(0, 3).map((item) => {
            const logo = logos[item as keyof typeof logos];

            return (
              <img
                src={logo.src}
                alt={item}
                class:list={["sponsor-logo", `sponsor-logo--${item}`]}
              />
            );
          })
        }
      </div>

      <div class="sponsor-logo-grid sponsor-logo-grid--gold-bottom">
        {
          sponsors.gold.slice(3).map((item) => {
            const logo = logos[item as keyof typeof logos];

            return (
              <img
                src={logo.src}
                alt={item}
                class:list={["sponsor-logo", `sponsor-logo--${item}`]}
              />
            );
          })
        }
      </div>
    </div>

    <div class="sponsor-tier">
      <div class="sponsor-tier__heading">
        <span></span>
        <Text as="h3" color="ink" class="sponsor-tier__label">
          {sponsors.silverLabel}
        </Text>
        <span></span>
      </div>

      <div class="sponsor-logo-grid sponsor-logo-grid--silver sponsor-logo-row">
        {
          sponsors.silver.map((item) => {
            const logo = logos[item as keyof typeof logos];

            return (
              <img
                src={logo.src}
                alt={item}
                class:list={["sponsor-logo", `sponsor-logo--${item}`]}
              />
            );
          })
        }
      </div>
    </div>

    <div class="sponsor-tier">
      <div class="sponsor-tier__heading">
        <span></span>
        <Text as="h3" color="ink" class="sponsor-tier__label">
          {sponsors.supporterLabel}
        </Text>
        <span></span>
      </div>

      {
        sponsors.supporter.map((item) => {
          const logo = logos[item as keyof typeof logos];

          return (
            <img
              src={logo.src}
              alt={item}
              class:list={["sponsor-logo", `sponsor-logo--${item}`]}
            />
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .sponsors-container {
    width: min(100% - 32px, 792px);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 60px;
  }

  .sponsors-title {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 700;
    line-height: 30px;
    letter-spacing: 0;
  }

  .sponsor-tier {
    width: min(100%, 660px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }

  .sponsor-tier--gold {
    width: min(100%, 792px);
  }

  .sponsor-tier__heading {
    width: min(100%, 660px);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 25px;
  }

  .sponsor-tier__heading span {
    height: 1px;
    flex: 1;
    background: rgba(0, 0, 0, 0.55);
  }

  .sponsor-tier__label {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 500;
    line-height: 28px;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .sponsor-logo-grid {
    display: grid;
    align-items: center;
    justify-content: center;
    justify-items: center;
    column-gap: 80px;
  }

  .sponsor-logo-grid--gold-top {
    grid-template-columns: repeat(3, auto);
  }

  .sponsor-logo-row,
  .sponsor-logo-grid--gold-bottom {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 80px;
  }

  .sponsor-logo-grid--gold-bottom {
    flex-wrap: wrap;
  }

  .sponsor-logo {
    width: auto;
    height: 80px;
    object-fit: contain;
  }

  .sponsor-logo--credaluga {
    width: 214px;
  }

  .sponsor-logo--realmate {
    width: 193px;
  }

  .sponsor-logo--pipeimob {
    width: 184px;
  }

  .sponsor-logo--grazon {
    width: 131px;
  }

  .sponsor-logo--upstate {
    width: 135px;
  }

  .sponsor-logo--fcanalise {
    width: 159px;
  }

  .sponsor-logo--lais {
    width: 127px;
  }

  .sponsor-logo--compagno {
    width: 118.76px;
    height: 31.32px;
  }

  .sponsor-logo--flexpro {
    width: 97.24px;
    height: 28.26px;
  }

  .sponsor-logo--lugui {
    width: 82px;
    height: 80px;
  }

  .sponsor-logo--guia-alma {
    width: 244px;
    height: 53px;
  }

  .sponsor-logo--orago {
    width: 142px;
    height: 42px;
  }

  @media (max-width: 767px) {
    .sponsors-container {
      gap: 44px;
    }

    .sponsor-tier__heading {
      gap: 16px;
    }

    .sponsor-tier__label {
      font-size: 18px;
      line-height: 22px;
    }

    .sponsor-logo-grid,
    .sponsor-logo-grid--gold-top,
    .sponsor-logo-grid--gold-bottom,
    .sponsor-logo-grid--silver {
      width: 100%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px 28px;
    }

    .sponsor-logo {
      max-width: 100%;
      height: 58px;
    }

    .sponsor-logo--orago {
      height: 38px;
    }
.sponsor-logo-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 18px 28px;
}
  }
</style>
