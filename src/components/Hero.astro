---
import Button from "./Button.astro";
import Text from "./Text.astro";
const { data } = Astro.props;
import heroBgDesktop from "../assets/bg-hero-desktop.webp";
import heroBgMobile from "../assets/bg-hero-mobile.webp";
import AluguelDayLogo from "../assets/logos/aluguel-day.svg";

const { hero } = data;

const {
  backgroundImage = heroBgDesktop.src,
  mobileBackgroundImage = heroBgMobile.src,
} = Astro.props;

const titleBreak = " de quem vive a ";
const [titleFirstLine, titleSecondLine] = hero.title.includes(titleBreak)
  ? hero.title.split(titleBreak)
  : [hero.title, ""];

const lotTurn = {
  label: "virada de lote",
  deadline: "2026-08-12T23:59:00-03:00",
  deadlineText: "12/08 23:59",
  units: [
    ["days", "dias"],
    ["hours", "hor"],
    ["minutes", "min"],
    ["seconds", "seg"],
  ],
};
---

<section
  class="hero-section relative w-full overflow-visible rounded-b-[64px] bg-navy bg-center bg-no-repeat"
  style={`--hero-bg-desktop: url("${backgroundImage}"); --hero-bg-mobile: url("${mobileBackgroundImage}");`}
>
  <div
    class="hero-content relative z-10 mx-auto flex max-w-216 flex-col items-center gap-5 px-6 pt-12 text-center lg:justify-center lg:gap-6 lg:px-0 lg:pt-0"
  >
    <img
      src={AluguelDayLogo.src}
      alt="Aluguel Day Logo"
      class="h-11 w-auto md:h-15"
    />

    <Text
      as="h1"
      variant="h1"
      color="white"
      align="center"
      class="hero-title"
    >
      {
        titleSecondLine ? (
          <>
            {titleFirstLine}
            <br />
            de quem vive a {titleSecondLine}
          </>
        ) : (
          hero.title
        )
      }
    </Text>
    <Text
      as="p"
      variant="body"
      color="white"
      align="center"
      class="max-w-2xs lg:max-w-full"
    >
      {hero.description}
    </Text>
    <div
      class="hero-countdown"
      data-countdown
      data-deadline={lotTurn.deadline}
      aria-label={`${lotTurn.label} ${lotTurn.deadlineText}`}
    >
      <p class="hero-countdown__headline">
        {lotTurn.label} <span aria-hidden="true">&bull;</span> {lotTurn.deadlineText}
      </p>
      <div class="hero-countdown__items" aria-live="polite">
        {
          lotTurn.units.map(([unit, label]) => (
            <div class="hero-countdown__item">
              <span class="hero-countdown__value" data-countdown-unit={unit}>
                00
              </span>
              <span class="hero-countdown__label">{label}</span>
            </div>
          ))
        }
      </div>
    </div>
    <Button>{hero.cta}</Button>
  </div>
</section>

<script>
  const padTime = (value: number) => String(Math.max(0, value)).padStart(2, "0");

  document.querySelectorAll("[data-countdown]").forEach((countdown) => {
    const deadlineValue = countdown.getAttribute("data-deadline");
    const deadline = deadlineValue ? new Date(deadlineValue).getTime() : 0;

    const updateCountdown = () => {
      const remaining = Math.max(0, deadline - Date.now());
      const totalSeconds = Math.floor(remaining / 1000);
      const values = {
        days: Math.floor(totalSeconds / 86400),
        hours: Math.floor((totalSeconds % 86400) / 3600),
        minutes: Math.floor((totalSeconds % 3600) / 60),
        seconds: totalSeconds % 60,
      };

      Object.entries(values).forEach(([unit, value]) => {
        countdown
          .querySelector(`[data-countdown-unit="${unit}"]`)
          ?.replaceChildren(padTime(value));
      });
    };

    updateCountdown();
    window.setInterval(updateCountdown, 1000);
  });
</script>

<style>
  .hero-section {
    background-image: var(--hero-bg-mobile);
    background-size: cover;
  }

  .hero-content {
    min-height: 48rem;
  }

  .hero-title {
    max-width: 760px;
  }

  .hero-countdown {
    position: absolute;
    bottom: 0;
    left: 50%;
    z-index: 20;
    display: flex;
    width: min(calc(100vw - 40px), 292px);
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    overflow: hidden;
    border-radius: 10px;
    background: var(--color-red);
    padding: 15px 35px;
    box-sizing: border-box;
    transform: translate(-50%, 50%);
  }

  .hero-countdown__headline {
    font-family: var(--font-boldonse);
    font-size: 13.142px;
    line-height: 11.734px;
    color: white;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .hero-countdown__items {
    display: flex;
    width: min(100%, 222px);
    align-items: center;
    gap: 10px;
  }

  .hero-countdown__item {
    display: flex;
    min-width: 0;
    width: 48px;
    flex: 0 1 48px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }

  .hero-countdown__value {
    display: flex;
    width: 100%;
    height: 34px;
    align-items: center;
    justify-content: center;
    border-radius: 5px;
    background: white;
    padding: 10px;
    box-sizing: border-box;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 500;
    line-height: 20px;
    color: var(--color-navy);
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .hero-countdown__label {
    width: 100%;
    font-family: var(--font-sans);
    font-size: 12px;
    line-height: 1;
    letter-spacing: -0.04em;
    color: white;
    text-align: center;
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    .hero-countdown {
      width: min(calc(100vw - 42px), 762px);
      flex-direction: row;
      gap: 50px;
      padding: 15px 35px;
    }

    .hero-countdown__headline {
      flex-shrink: 0;
      font-size: 28px;
      line-height: 25px;
    }

    .hero-countdown__items {
      flex: 1 0 0;
      min-width: 0;
      width: auto;
    }

    .hero-countdown__item {
      flex: 1 0 0;
      width: auto;
    }
  }

  @media (min-width: 1024px) {
    .hero-section {
      background-image: var(--hero-bg-desktop);
      background-size: cover;
    }

    .hero-content {
      min-height: 620px;
      padding-bottom: 1.25rem;
    }
  }
</style>
