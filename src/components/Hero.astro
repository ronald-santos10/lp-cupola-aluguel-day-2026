---
import Button from "./Button.astro";
import Text from "./Text.astro";
const { data } = Astro.props;
import heroBgDesktop from "../assets/bg-hero-desktop.webp";
import heroBgMobile from "../assets/bg-hero-mobile.webp";
import AluguelDayLogo from "../assets/logos/aluguel-day.svg";

const { hero } = data;

const {
  backgroundImage = heroBgDesktop.src,
  mobileBackgroundImage = heroBgMobile.src,
} = Astro.props;

const titleBreak = " de quem vive a ";
const [titleFirstLine, titleSecondLine] = hero.title.includes(titleBreak)
  ? hero.title.split(titleBreak)
  : [hero.title, ""];
---

<section
  class="hero-section relative w-full overflow-visible rounded-b-[64px] bg-navy bg-center bg-no-repeat"
  style={`--hero-bg-desktop: url("${backgroundImage}"); --hero-bg-mobile: url("${mobileBackgroundImage}");`}
>
  <div
    class="hero-content relative z-10 mx-auto flex max-w-216 flex-col items-center gap-5 px-6 pt-12 text-center lg:justify-center lg:gap-6 lg:px-0 lg:pt-0"
  >
    <img
      src={AluguelDayLogo.src}
      alt="Aluguel Day Logo"
      class="h-11 w-auto md:h-15"
    />

    <Text
      as="h1"
      variant="h1"
      color="white"
      align="center"
      class="hero-title"
    >
      {
        titleSecondLine ? (
          <>
            {titleFirstLine}
            <br />
            de quem vive a {titleSecondLine}
          </>
        ) : (
          hero.title
        )
      }
    </Text>
    <Text
      as="p"
      variant="body"
      color="white"
      align="center"
      class="max-w-2xs lg:max-w-full"
    >
      {hero.description}
    </Text>
    <Button>{hero.cta}</Button>
  </div>

  <div
    class="absolute
    left-1/2
    bottom-0
    z-20
    -translate-x-1/2
    translate-y-1/2"
  >
    <div
      class="whitespace-nowrap
      rounded-xl
      bg-blue
      px-8
      py-3
      text-base
      text-white
      shadow-lg"
    >
      {hero.preSale}
    </div>
  </div>
</section>

<style>
  .hero-section {
    background-image: var(--hero-bg-mobile);
    background-size: cover;
  }

  .hero-content {
    min-height: 48rem;
  }

  .hero-title {
    max-width: 760px;
  }

  @media (min-width: 1024px) {
    .hero-section {
      background-image: var(--hero-bg-desktop);
      background-size: cover;
    }

    .hero-content {
      min-height: 620px;
      padding-bottom: 1.25rem;
    }
  }
</style>
