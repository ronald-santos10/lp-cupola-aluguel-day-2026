---
import logo from "../assets/logos/aluguel-day.svg";
---

<style>
  @keyframes popupBounceIn {
    from,
    20%,
    40%,
    60%,
    80%,
    to {
      animation-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
    }

    0% {
      opacity: 0;
      transform: scale3d(0.3, 0.3, 0.3);
    }

    20% {
      transform: scale3d(1.1, 1.1, 1.1);
    }

    40% {
      transform: scale3d(0.9, 0.9, 0.9);
    }

    60% {
      opacity: 1;
      transform: scale3d(1.03, 1.03, 1.03);
    }

    80% {
      transform: scale3d(0.97, 0.97, 0.97);
    }

    to {
      opacity: 1;
      transform: scale3d(1, 1, 1);
    }
  }

  @keyframes popupFadeOut {
    from {
      opacity: 1;
      transform: scale3d(1, 1, 1);
    }

    to {
      opacity: 0;
      transform: scale3d(0.92, 0.92, 0.92);
    }
  }

  .popup-bounce-in {
    animation: popupBounceIn 0.8s both;
    transform-origin: center center;
    will-change: transform, opacity;
  }

  .popup-fade-out {
    animation: popupFadeOut 0.2s ease both;
  }

  /* Card is a 1:1 square, matching the 1200x1200 Figma frame. Every
     measurement below is derived directly from that 1200px frame so the
     proportions stay exact regardless of rendered size (cqw = % of the
     card's own width, since the card is always square). */
  .exit-popup-card {
    position: relative;
    width: 100%;
    max-width: 720px;
    aspect-ratio: 1;
    border-radius: 8.333%; /* 100 / 1200 */
    background: #3d36ff;
    container-type: inline-size;
    overflow: hidden;
  }

  .exit-popup-content {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .exit-popup-title {
    position: absolute;
    left: 50%;
    top: 14.917%; /* 179 / 1200 */
    width: 82.167%; /* 986 / 1200 */
    transform: translateX(-50%);
    font-family: var(--font-boldonse);
    font-size: clamp(24px, 6.611cqw, 79.329px); /* 79.329 / 1200 */
    line-height: 1.537; /* 121.913 / 79.329 */
    letter-spacing: -0.01em;
  }

  .exit-popup-description {
    position: absolute;
    left: 50%;
    top: 37%; /* 444 / 1200 */
    width: 84.083%; /* 1009 / 1200 */
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-size: clamp(16px, 3.663cqw, 43.959px); /* 43.959 / 1200 */
    line-height: 1.34; /* 58.907 / 43.959 */
    letter-spacing: -0.01em;
  }

  .exit-popup-price {
    position: absolute;
    left: 50%;
    top: 48.5%; /* 582 / 1200 */
    width: 84.083%; /* 1009 / 1200 */
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-size: clamp(18px, 4.353cqw, 52.237px); /* 52.237 / 1200 */
    line-height: 1.34; /* 70 / 52.237 */
    letter-spacing: -0.01em;
    text-underline-offset: 0.11em;
    text-decoration-thickness: 0.05em;
  }

  .exit-popup-cta {
    position: absolute;
    left: 50%;
    top: 59.75%; /* 717 / 1200 */
    width: 51.167%; /* 614 / 1200 */
    min-height: 10.833cqw; /* 130 / 1200 */
    transform: translateX(-50%);
    border: 0.833cqw solid rgb(176 249 10 / 0.4); /* 10 / 1200 */
    border-radius: 999px;
    padding: 0;
    font-family: var(--font-display);
    font-size: clamp(18px, 3.75cqw, 45px); /* 45 / 1200 */
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .exit-popup-footer {
    position: absolute;
    left: 50%;
    bottom: 8.168%;
    width: 82.167%;
    transform: translateX(-50%);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    column-gap: 1rem;
    align-items: center;
    justify-items: center;
    font-family: var(--font-display);
    font-size: clamp(12px, 2.162cqw, 25.949px);
    line-height: 1.156;
    letter-spacing: -0.03em;
  }

  .exit-popup-logo {
    width: min(200px, 100%);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .exit-popup-logo-aluguel {
    width: 100%;
    height: auto;
    margin: 0;
    display: block;
  }

  @media (max-width: 640px) {
    #exit-popup {
      display: none;
    }
  }
</style>

<div
  id="exit-popup"
  class="pointer-events-none fixed inset-0 z-9999 flex items-center justify-center bg-black/60 p-5 opacity-0 transition-opacity duration-300"
>
  <div
    id="exit-popup-card"
    class="exit-popup-card shadow-2xl"
  >
    <div
      id="exit-popup-content"
      class="exit-popup-content text-white text-center"
    >
      <button
        id="exit-popup-close"
        aria-label="Fechar popup"
        class="absolute right-4 top-4 z-20 flex h-9 w-9 items-center justify-center rounded-full bg-white/10 font-sans text-2xl leading-none text-white transition hover:bg-white/20 md:right-6 md:top-6 md:h-10 md:w-10"
      >
        &times;
      </button>

      <h2 class="exit-popup-title z-10 uppercase text-lime">
        Vai sair sem garantir sua vaga?
      </h2>

      <p class="exit-popup-description z-10 text-white font-light">
        O CUPOLA Aluguel Day reúne <strong class="font-bold">+15 conteúdos</strong> em um dia inteiro dedicado a quem opera locação.
      </p>

      <p class="exit-popup-price z-10 font-bold text-white underline">
        Tudo isso a partir de R$ 229,00
      </p>

      <a
        id="exit-popup-action"
        href="https://www.sympla.com.br/evento/cupola-aluguel-day/3465310?utm_source=site&utm_medium=popup_saida&utm_campaign=cupola_aluguel_day"
        class="exit-popup-cta z-10 inline-flex items-center justify-center bg-lime font-bold uppercase text-navy transition"
      >
        GARANTIR AGORA
      </a>

      <div
        class="exit-popup-footer z-10 grid grid-cols-[1fr_1.42fr_1fr] items-end text-white"
      >
        <p class="text-left">
          Curitiba<br />
          30 Set 2026
        </p>

        <div class="exit-popup-logo relative mx-auto">
          <img
            src={logo.src}
            alt="CUPOLA Aluguel Day"
            class="exit-popup-logo-aluguel"
          />
        </div>
        <p class="text-right">
          Presencial<br />e Online
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const STORAGE_KEY = "exit-popup-opened";
    const mobileViewport = window.matchMedia("(max-width: 640px)");

    const popup = document.getElementById("exit-popup")!;
    const content = document.getElementById("exit-popup-content")!;
    const close = document.getElementById("exit-popup-close");
    const action = document.getElementById("exit-popup-action");
    const popupEl = popup;
    const cardEl = document.getElementById("exit-popup-card")!;

    if (
      !popup ||
      !content ||
      mobileViewport.matches ||
      sessionStorage.getItem(STORAGE_KEY)
    )
      return;

    let opened = false;

    function openPopup() {
      if (opened || mobileViewport.matches) return;

      opened = true;

      sessionStorage.setItem(STORAGE_KEY, "1");

      popupEl.classList.remove("pointer-events-none", "opacity-0");

      cardEl.classList.remove("popup-fade-out");

      cardEl.classList.remove("popup-bounce-in");
      void cardEl.offsetWidth;
      cardEl.classList.add("popup-bounce-in");

      document.body.style.overflow = "hidden";
    }

    function closePopup() {
      cardEl.classList.remove("popup-bounce-in");
      cardEl.classList.add("popup-fade-out");

      popupEl.classList.add("opacity-0");

      setTimeout(() => {
        popupEl.classList.add("pointer-events-none");
        cardEl.classList.remove("popup-fade-out");
        document.body.style.overflow = "";
      }, 200);
    }

    document.addEventListener("mouseout", (e) => {
      if (e.relatedTarget) return;

      if (e.clientY <= 5) {
        openPopup();
      }
    });

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") {
        openPopup();
      }
    });

    close?.addEventListener("click", closePopup);

    action?.addEventListener("click", () => {
      closePopup();
    });

    popup.addEventListener("click", (e) => {
      if (e.target === popup) {
        closePopup();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closePopup();
      }
    });
  })();
</script>
