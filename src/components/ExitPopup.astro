---
import logo from "../assets/logos/aluguel-day.svg";
---

<style>
  @keyframes popupBounceIn {
    from,
    20%,
    40%,
    60%,
    80%,
    to {
      animation-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
    }

    0% {
      opacity: 0;
      transform: scale3d(0.3, 0.3, 0.3);
    }

    20% {
      transform: scale3d(1.1, 1.1, 1.1);
    }

    40% {
      transform: scale3d(0.9, 0.9, 0.9);
    }

    60% {
      opacity: 1;
      transform: scale3d(1.03, 1.03, 1.03);
    }

    80% {
      transform: scale3d(0.97, 0.97, 0.97);
    }

    to {
      opacity: 1;
      transform: scale3d(1, 1, 1);
    }
  }

  @keyframes popupFadeOut {
    from {
      opacity: 1;
      transform: scale3d(1, 1, 1);
    }

    to {
      opacity: 0;
      transform: scale3d(0.92, 0.92, 0.92);
    }
  }

  .popup-bounce-in {
    animation: popupBounceIn 0.8s both;
    transform-origin: center center;
    will-change: transform, opacity;
  }

  .popup-fade-out {
    animation: popupFadeOut 0.2s ease both;
  }

  /* Card is a 1:1 square, matching the 1200x1200 Figma frame. Every
     measurement below is derived directly from that 1200px frame so the
     proportions stay exact regardless of rendered size (cqw = % of the
     card's own width, since the card is always square). */
  .exit-popup-card {
    position: relative;
    width: 100%;
    max-width: 720px;
    aspect-ratio: 1;
    border-radius: 8.333%; /* 100 / 1200 */
    background: #3d36ff;
    container-type: inline-size;
    overflow: hidden;
  }

  .exit-popup-content {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .exit-popup-kicker {
    position: absolute;
    left: 50%;
    top: 14%; /* 168 / 1200 */
    width: 82.167%;
    transform: translateX(-50%);
    font-family: var(--font-display);
    font-size: clamp(22px, 5.25cqw, 63px);
    font-weight: 500;
    line-height: 1.571;
    letter-spacing: -0.01em;
  }

  .exit-popup-title {
    position: absolute;
    left: 50%;
    top: 26.792%; /* 321.5 / 1200 */
    width: 92%;
    transform: translateX(-50%);
    font-family: var(--font-boldonse);
    font-size: clamp(42px, 9.396cqw, 112.75px);
    line-height: 1.494;
    letter-spacing: 0;
  }

  .exit-popup-title-main {
    position: absolute;
    left: 50%;
    top: 24.5%;
    width: 92%;
    transform: translateX(-50%);
    font-family: var(--font-boldonse);
    font-size: clamp(48px, 9.396cqw, 120px);
    line-height: 1.06; /* increased line-height for more vertical spacing */
    letter-spacing: 0;
    margin: 0;
  }

  .exit-popup-title-date {
    position: absolute;
    left: 50%;
    top: 37.5%; /* moved slightly down to increase gap from main title */
    width: 92%;
    transform: translateX(-50%);
    font-family: var(--font-boldonse);
    font-size: clamp(48px, 9.396cqw, 120px);
    line-height: 1.06; /* match increased line-height */
    letter-spacing: 0;
    margin: 0;
  }

  .exit-popup-offer {
    position: absolute;
    left: 50%;
    top: 50.25%; /* 603 / 1200 */
    width: 84.083%;
    transform: translateX(-50%);
    border-bottom: 0.331cqw solid white; /* 3.969 / 1200 */
    border-top: 0.331cqw solid white;
    padding: 2.067cqw 0.827cqw; /* 24.805 / 1200, 9.922 / 1200 */
    font-family: var(--font-display);
    font-size: clamp(18px, 4.824cqw, 57.89px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    /* add a little extra visual gap below the offer */
    margin-bottom: 1.5cqw;
  }

  .exit-popup-cta {
    position: absolute;
    left: 50%;
    top: 64.5%; /* moved down to create spacing from the offer */
    width: 51.167%; /* 614 / 1200 */
    min-height: 10.833cqw; /* 130 / 1200 */
    transform: translateX(-50%);
    border: 0.833cqw solid rgb(176 249 10 / 0.4); /* 10 / 1200 */
    border-radius: 999px;
    padding: 0;
    font-family: var(--font-display);
    font-size: clamp(18px, 3.75cqw, 45px); /* 45 / 1200 */
    line-height: 1;
    letter-spacing: 0;
    white-space: nowrap;
  }

  .exit-popup-footer {
    position: absolute;
    left: 50%;
    bottom: 8.168%;
    width: 82.167%;
    transform: translateX(-50%);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    column-gap: 1rem;
    align-items: center;
    justify-items: center;
    font-family: var(--font-display);
    font-size: clamp(12px, 2.162cqw, 25.949px);
    line-height: 1.156;
    letter-spacing: -0.03em;
  }

  .exit-popup-logo {
    width: min(200px, 100%);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .exit-popup-logo-aluguel {
    width: 100%;
    height: auto;
    margin: 0;
    display: block;
  }

  @media (max-width: 640px) {
    #exit-popup {
      display: none;
    }
  }
</style>

