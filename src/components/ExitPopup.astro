---
import logo from "../assets/logos/aluguel-day.svg";
---

<style>
  @keyframes popupBounceIn {
    from,
    20%,
    40%,
    60%,
    80%,
    to {
      animation-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1);
    }

    0% {
      opacity: 0;
      transform: scale3d(0.3, 0.3, 0.3);
    }

    20% {
      transform: scale3d(1.1, 1.1, 1.1);
    }

    40% {
      transform: scale3d(0.9, 0.9, 0.9);
    }

    60% {
      opacity: 1;
      transform: scale3d(1.03, 1.03, 1.03);
    }

    80% {
      transform: scale3d(0.97, 0.97, 0.97);
    }

    to {
      opacity: 1;
      transform: scale3d(1, 1, 1);
    }
  }

  @keyframes popupFadeOut {
    from {
      opacity: 1;
      transform: scale3d(1, 1, 1);
    }

    to {
      opacity: 0;
      transform: scale3d(0.92, 0.92, 0.92);
    }
  }

  .popup-bounce-in {
    animation: popupBounceIn 0.8s both;
    transform-origin: center center;
    will-change: transform, opacity;
  }

  .popup-fade-out {
    animation: popupFadeOut 0.2s ease both;
  }

  /* .exit-popup-art {
    background:
      linear-gradient(116deg, transparent 0 77%, #fe122a 77.2% 90%, transparent 90.2%),
      linear-gradient(116deg, transparent 0 73%, #3d36ff 73.2% 77.2%, transparent 77.4%),
      linear-gradient(55deg, transparent 0 9%, #3d36ff 9.2% 14.8%, transparent 15%),
      linear-gradient(55deg, transparent 0 5.5%, #fe122a 5.7% 8.8%, transparent 9%),
      #090e24;
  } */

  .exit-popup-ribbon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 360px;
    height: 54px;
    transform: translate(-28%, 52%) rotate(-35deg);
  }

  @media (max-width: 640px) {
    .exit-popup-ribbon {
      width: 310px;
      height: 48px;
      transform: translate(-18%, 56%) rotate(-35deg);
    }
  }
</style>

<div
  id="exit-popup"
  class="pointer-events-none fixed inset-0 z-9999 flex items-center justify-center bg-black/60 p-5 opacity-0 transition-opacity duration-300"
>
  <div
    id="exit-popup-card"
    class="relative w-full max-w-180 overflow-hidden rounded-card bg-navy shadow-2xl"
  >
    <div
      id="exit-popup-content"
      class="exit-popup-art relative flex min-h-140 w-full flex-col px-6 py-8 text-center text-white sm:min-h-155 sm:px-10 md:px-12 md:py-10"
    >
      <button
        id="exit-popup-close"
        aria-label="Fechar popup"
        class="absolute right-4 top-4 z-20 flex h-9 w-9 items-center justify-center rounded-full bg-white/10 font-sans text-2xl leading-none text-white transition hover:bg-white/20 md:right-6 md:top-6 md:h-10 md:w-10"
      >
        &times;
      </button>

      <div
        class="exit-popup-ribbon absolute left-0 top-0 z-10 bg-red"
      >
        <span
          class="block whitespace-nowrap font-sans text-sm font-medium uppercase tracking-normal text-white sm:text-lg md:text-xl"
        >
          LOTE 1 ABERTO
        </span>
      </div>

      <div
        class="relative z-10 mx-auto flex flex-1 flex-col items-center justify-center pt-8 sm:pt-12"
      >
        <p
          class="font-display text-xl font-bold uppercase leading-none tracking-normal sm:text-3xl md:text-[34px]"
        >
          ANTES DE IR...
        </p>

        <h2
          class="mt-8 max-w-135 font-display text-[25px] font-bold uppercase leading-[1.15] tracking-normal sm:mt-10 sm:text-[34px] md:text-[40px]"
        >
          O Cupola Aluguel Day já está com vendas abertas.
        </h2>

        <p
          class="mt-6 max-w-115 font-sans text-lg uppercase leading-tight tracking-normal sm:text-[22px] md:text-[28px]"
        >
          Você e seu time merecem estar nesse encontro.
        </p>

        <a
          id="exit-popup-action"
          href="#ingressos"
          class="mt-7 inline-flex min-h-10 items-center justify-center rounded-[10px] border border-lime/35 bg-lime px-7 font-sans text-sm font-bold uppercase tracking-normal text-ink transition hover:-translate-y-0.5 sm:px-8 sm:text-base md:text-lg"
          style="box-shadow:0 0 0 3px rgb(176 249 10 / .35)"
        >
          GARANTIR AGORA
        </a>
      </div>

      <div
        class="relative z-10 grid grid-cols-3 items-end gap-3 font-sans text-sm tracking-normal sm:text-base md:text-lg"
      >
        <p class="text-left">30 Set 2026</p>
        <img
          src={logo.src}
          alt="CUPOLA Aluguel Day"
          class="mx-auto w-36 sm:w-48 md:w-56"
        />
        <p class="text-right leading-none">
          Presencial<br />
          em Curitiba
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  (() => {
    const STORAGE_KEY = "exit-popup-opened";

    const popup = document.getElementById("exit-popup")!;
    const content = document.getElementById("exit-popup-content")!;
    const close = document.getElementById("exit-popup-close");
    const action = document.getElementById("exit-popup-action");
    const popupEl = popup;
    const cardEl = document.getElementById("exit-popup-card")!;

    if (!popup || !content || sessionStorage.getItem(STORAGE_KEY)) return;

    let opened = false;

    function openPopup() {
      if (opened) return;

      opened = true;

      sessionStorage.setItem(STORAGE_KEY, "1");

      popupEl.classList.remove("pointer-events-none", "opacity-0");

      cardEl.classList.remove("popup-fade-out");

      cardEl.classList.remove("popup-bounce-in");
      void cardEl.offsetWidth;
      cardEl.classList.add("popup-bounce-in");

      document.body.style.overflow = "hidden";
    }

    function closePopup() {
      cardEl.classList.remove("popup-bounce-in");
      cardEl.classList.add("popup-fade-out");

      popupEl.classList.add("opacity-0");

      setTimeout(() => {
        popupEl.classList.add("pointer-events-none");
        cardEl.classList.remove("popup-fade-out");
        document.body.style.overflow = "";
      }, 200);
    }

    document.addEventListener("mouseout", (e) => {
      if (e.relatedTarget) return;

      if (e.clientY <= 5) {
        openPopup();
      }
    });

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "hidden") {
        openPopup();
      }
    });

    close?.addEventListener("click", closePopup);

    action?.addEventListener("click", () => {
      closePopup();
    });

    popup.addEventListener("click", (e) => {
      if (e.target === popup) {
        closePopup();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closePopup();
      }
    });
  })();
</script>
